  "skills": [
    {
      "id": 1,
      "category": "Project Management",
      "subcategory": "Planning",
      "title": "Create Comprehensive Project Charter",
      "description": "Develop a formal project charter that defines scope, objectives, and authority for a new project",
      "difficulty": "intermediate",
      "time_estimate": "2-4 hours",
      "steps": [
        "Gather stakeholder requirements and expectations",
        "Define project objectives and measurable success criteria",
        "Identify project constraints and assumptions",
        "Document resource requirements and budget",
        "Establish project governance structure",
        "Get executive sponsor approval",
        "Distribute charter to all stakeholders"
      ],
      "best_practices": [
        "Involve key stakeholders in the creation process",
        "Ensure alignment with organizational strategy",
        "Keep the charter concise yet comprehensive",
        "Document assumptions explicitly",
        "Review and update annually"
      ],
      "tools": ["Microsoft Project", "Asana", "JIRA", "Monday.com"],
      "keywords": ["charter", "planning", "scope", "governance"]
    },
    {
      "id": 2,
      "category": "Project Management",
      "subcategory": "Planning",
      "title": "Develop Work Breakdown Structure (WBS)",
      "description": "Create a hierarchical decomposition of project scope into manageable deliverables",
      "difficulty": "intermediate",
      "time_estimate": "1-3 hours",
      "steps": [
        "Review project charter and scope statement",
        "Identify major deliverables",
        "Decompose deliverables into work packages",
        "Define level of detail needed for control",
        "Assign unique identifiers to each element",
        "Validate with stakeholders",
        "Document assumptions and constraints"
      ],
      "best_practices": [
        "Use 100% rule (all work included once)",
        "Limit to 3-5 levels of decomposition",
        "Make work packages measurable and achievable",
        "Involve the project team in creation",
        "Review for completeness and balance"
      ],
      "tools": ["Lucidchart", "SmartDraw", "Microsoft Visio", "Miro"],
      "keywords": ["WBS", "scope", "decomposition", "deliverables"]
    },
    {
      "id": 3,
      "category": "Project Management",
      "subcategory": "Scheduling",
      "title": "Build and Optimize Project Schedule",
      "description": "Develop a realistic project schedule with dependencies, durations, and resource allocation",
      "difficulty": "advanced",
      "time_estimate": "3-6 hours",
      "steps": [
        "Identify all activities from WBS",
        "Estimate duration for each activity",
        "Determine activity dependencies and sequencing",
        "Assign resources to activities",
        "Calculate critical path",
        "Identify scheduling constraints",
        "Develop baseline schedule",
        "Analyze risks and build contingency buffers"
      ],
      "best_practices": [
        "Use three-point estimation for accuracy",
        "Account for resource availability",
        "Build in contingency reserves",
        "Maintain schedule flexibility",
        "Communicate realistic timelines"
      ],
      "tools": ["Microsoft Project", "Smartsheet", "GanttProject", "Wdesk"],
      "keywords": ["schedule", "gantt", "critical path", "duration"]
    },
    {
      "id": 4,
      "category": "Project Management",
      "subcategory": "Risk Management",
      "title": "Conduct Risk Assessment and Planning",
      "description": "Identify, analyze, and develop response strategies for project risks",
      "difficulty": "advanced",
      "time_estimate": "4-8 hours",
      "steps": [
        "Conduct risk brainstorming session with team",
        "Document identified risks with descriptions",
        "Categorize risks by source and type",
        "Assess probability and impact of each risk",
        "Prioritize risks using risk matrix",
        "Develop response strategies (mitigate, avoid, transfer, accept)",
        "Assign risk owners",
        "Create risk register and monitoring plan"
      ],
      "best_practices": [
        "Involve cross-functional team in identification",
        "Update risk register regularly",
        "Distinguish between risks and issues",
        "Develop contingency plans for high-priority risks",
        "Document lessons learned"
      ],
      "tools": ["Risk Radar", "Palisade @RISK", "Oracle Risk Management", "Domo"],
      "keywords": ["risk", "probability", "impact", "mitigation"]
    },
